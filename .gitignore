# ---------------------------------------------------------------------------
# Gradle / build output
# ---------------------------------------------------------------------------
.gradle/
build/
**/build/
captures/
.externalNativeBuild/
.cxx/
.kotlin/
*.hprof

# ---------------------------------------------------------------------------
# Local machine configuration (never commit: contains local paths & secrets)
# ---------------------------------------------------------------------------
local.properties

# Release signing material. keystore.properties holds the keystore password,
# so it must stay on your machine only. Without it the release build falls back
# to an unsigned APK instead of failing.
keystore.properties
*.jks
*.keystore
*.p12

# Generated by `gradle updateDaemonJvm`; pins a machine-specific JDK download,
# so it stays local and Gradle falls back to the JVM running the build.
gradle/gradle-daemon-jvm.properties

# ---------------------------------------------------------------------------
# Android Studio / IntelliJ IDEA
# ---------------------------------------------------------------------------
.idea/
*.iml
*.log

# ---------------------------------------------------------------------------
# Build artifacts / installable packages
# ---------------------------------------------------------------------------
*.apk
*.aab
*.ap_
*.dex

# ---------------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
